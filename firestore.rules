rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/commercial_users/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && exists(currentUserPath());
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    function isActive() {
      return currentUserExists() && currentUser().active == true;
    }

    function isManager() {
      return isActive() && currentUser().role == "manager";
    }

    function isManagerBootstrap(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.email == "143561@actividad.local"
        && request.resource.data.employeeNumber == "143561"
        && request.resource.data.role == "manager"
        && request.resource.data.active == true;
    }

    function isAdvisorBootstrap(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.email.matches('^[0-9]+@actividad[.]local$')
        && request.resource.data.employeeNumber is string
        && request.resource.data.role == "advisor"
        && request.resource.data.active == true;
    }

    match /commercial_users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isManager()
      );

      allow create: if isManager()
        || isManagerBootstrap(userId)
        || isAdvisorBootstrap(userId);

      allow update: if isManager()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["lastLoginAt", "updatedAt"])
        );

      allow delete: if false;
    }

    match /commercial_activity_reports/{reportId} {
      allow create: if isActive()
        && currentUser().role == "advisor"
        && request.resource.data.advisorUid == request.auth.uid
        && request.resource.data.advisorEmployeeNumber == currentUser().employeeNumber
        && request.resource.data.advisorName == currentUser().name
        && request.resource.data.status == "finalized";

      allow read: if isActive()
        && (
          isManager()
          || resource.data.advisorUid == request.auth.uid
        );

      allow update: if isManager();
      allow delete: if false;
    }
  }
}
